{
  "@context": "https://www.w3.org/2022/wot/td/v1.1",
  "id": "urn:example:controller",
  "title": "Production Controller",
  "description": "A system controller that manages two robots in a production chain",
  "securityDefinitions": {
    "basic_sc": {
      "scheme": "basic",
      "in": "header"
    }
  },
  "security": [
    "basic_sc"
  ],
  "base": "http://example.org/controller/",
  "actions": {
    "startSystem": {
      "forms": [
        {
          "href": "actions/startSystem",
          "contentType": "application/json",
          "op": "invokeaction"
        }
      ]
    },
    "stopSystem": {
      "forms": [
        {
          "href": "actions/stopSystem",
          "contentType": "application/json",
          "op": "invokeaction"
        }
      ]
    },
    "action1": {
      "forms": [
        {
          "href": "actions/action1",
          "contentType": "application/json",
          "op": "invokeaction"
        }
      ]
    }
  }
}
